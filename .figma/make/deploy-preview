#!/usr/bin/env bash
set -euo pipefail

# This project is a dependency-free static site: index.html is the whole app.
# There is no bundler, so the "build" is assembling the static files into dist/.
BUILD_DIR="dist"

rm -rf "$BUILD_DIR"
mkdir -p "$BUILD_DIR"
cp index.html "$BUILD_DIR/"

exec figma make deploy-preview --build-dir "$BUILD_DIR"
