#!/usr/bin/env bash
set -euo pipefail

build_dir=".figma/make/dist"

rm -rf "$build_dir"
mkdir -p "$build_dir"
cp index.html "$build_dir/index.html"
[[ -f "$build_dir/index.html" ]] || {
  echo "Expected build output at $build_dir/index.html" >&2
  exit 1
}

figma make deploy --build-dir "$build_dir"
